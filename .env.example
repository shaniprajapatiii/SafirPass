# Neon Serverless Postgres Connection String
# Example: postgresql://username:password@ep-sample-123.us-east-2.aws.neon.tech/safirpass?sslmode=require
DATABASE_URL=""

# Google OAuth 2.0 Credentials (Set your Google Cloud Console credentials here)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT Secret for Session & Cryptographic ID Tokens
JWT_SECRET=""

# Authority / Government Admin Portal Credentials
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_SECRET_KEY="safirpass-gov-authority-secure-key"

# MongoDB Database Connection String
MONGODB_URI="mongodb://127.0.0.1:27017/safirpass"
MONGODB_DB_NAME="safirpass"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# FastAPI Backend Service URL
FASTAPI_URL="http://127.0.0.1:8000"

# Google Gemini LLM Safety & Incident Intelligence API
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=""

# AWS Cloud Services: Rekognition Biometrics & Amazon SNS Emergency Dispatch
# Region typically "ap-south-1" (Asia Pacific - Mumbai) for low latency across India
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
REKOGNITION_ENABLED="true"
SNS_TOPIC_ARN="arn:aws:sns:ap-south-1:123456789012:safirpass-emergency-alerts"